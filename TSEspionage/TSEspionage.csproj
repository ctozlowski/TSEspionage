<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>0.2.0</Version>
    <Title>Twilight Struggle Espionage Library</Title>
    <Authors>Emily Noneman</Authors>
    <Description>A mod for Playdek's Twilight Struggle that includes improvements and bug-fixes.</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- Disable nullable warnings for now since we're migrating -->
    <Nullable>disable</Nullable>
    
    <!-- Output to BepInEx plugins folder for easy testing -->
    <OutputPath>..\game\Twilight Struggle\BepInEx\plugins\TSEspionage\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- BepInEx Core References -->
  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>..\game\Twilight Struggle\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>..\game\Twilight Struggle\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>..\game\Twilight Struggle\BepInEx\core\BepInEx.Unity.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- HarmonyX (bundled with BepInEx 6) -->
    <Reference Include="0Harmony">
      <HintPath>..\game\Twilight Struggle\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Il2CppInterop Runtime (for IL2CPP type system) -->
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\game\Twilight Struggle\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>..\game\Twilight Struggle\BepInEx\core\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 
    IL2CPP Interop Assemblies - Generated by BepInEx on first run
    These will be created in BepInEx/interop/ folder when the game is launched.
    Until the game is run once on Windows, these won't exist.
    
    For development, you can:
    1. Run the game on Windows with BepInEx installed to generate these
    2. Copy the interop folder back to your dev machine
    3. Uncomment these references
  -->
  <ItemGroup Condition="Exists('..\game\Twilight Struggle\BepInEx\interop\')">
    <Reference Include="Il2Cppmscorlib">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppAssembly-CSharp">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\Il2CppAssembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\game\Twilight Struggle\BepInEx\interop\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
